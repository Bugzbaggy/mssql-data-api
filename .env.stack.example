# Copy to .env.stack and fill in. Used by docker-compose.stack.yml only.
# Local container credentials. Never reuse a real password here.
MSSQL_SA_PASSWORD=Str0ng!DemoPassw0rd
# This demo stack authenticates the DBA server as `sa` for simplicity - the seed step
# creates no dedicated login. That is fine for this local, throwaway container only.
# A real deployment must NOT use sa here: point it at a login granted VIEW SERVER STATE
# and nothing more.
DBA_MCP_USER=sa
DBA_MCP_PASSWORD=Str0ng!DemoPassw0rd
# Ports on the host.
DAB_MCP_PORT=5000
DBA_MCP_PORT=3000
