# appdb-data-api — environment template
# ============================================================================
# LOCAL DEV ONLY. Copy to .env (gitignored) and fill in a NON-prod credential.
# PRODUCTION does NOT use this file — the CONN_* / AUTH_* values are injected
# into the pod from AWS Secrets Manager at runtime (see deploy/). Never put a real
# password in a file, in the image, or in source control.
# ----------------------------------------------------------------------------
# Prod/staging connections target an AG LISTENER with ApplicationIntent=ReadOnly
# (routes to a readable secondary AND follows the primary after failover) + MultiSubnetFailover.
# The login (svc_dataapi) is least-privilege: EXECUTE on the curated SPs only, no sysadmin.
# ============================================================================

# --- Which config/auth to run (see deploy/README.md "Environments & authentication") ---
# Local    -> DAB_ENVIRONMENT=Local  + dab-config.json      (Simulator; pass X-MS-API-ROLE)
# Staging  -> DAB_ENVIRONMENT=Staging + dab-config.json     (Simulator; prod-shaped; point CONN_* at staging)
# Prod     -> (unset)                 + dab-config.json      (EntraID; example SSO)
# Dev      -> run the CLI: start -c config/dab-config.dev.json (standalone; set CONN_DEV below)
DAB_ENVIRONMENT=Local

# === PROD / STAGING (base config: AppCatalog global + AppDb_Data region) ===
# Global config/reference (AppCatalog) — SG listener (prod) / staging listener
CONN_GLOBAL_CONFIG=Server=ag-sg-lsnr,1433;Database=AppCatalog;User ID=svc_dataapi;Password=<secret>;ApplicationIntent=ReadOnly;MultiSubnetFailover=True;Encrypt=True;TrustServerCertificate=False;Application Name=appdb-data-api
# Region-local (AppDb_Data) — per-region listener
CONN_ID_MSGDATA=Server=ag-id-lsnr,1433;Database=AppDb_Data;User ID=svc_dataapi;Password=<secret>;ApplicationIntent=ReadOnly;MultiSubnetFailover=True;Encrypt=True;TrustServerCertificate=False;Application Name=appdb-data-api
# Uncomment when uk/us region sources are added to data-source-files:
# CONN_UK_MSGDATA=Server=ag-uk-lsnr,1433;Database=AppDb_Data;...ApplicationIntent=ReadOnly...
# CONN_US_MSGDATA=Server=ag-us-lsnr,1433;Database=AppDb_Data;...ApplicationIntent=ReadOnly...

# --- STAGING overrides (prod-shaped; same base config, DAB_ENVIRONMENT=Staging) ---
# CONN_GLOBAL_CONFIG=Server=ag-staging-listener,1433;Database=AppCatalog;User ID=svc_dataapi;Password=<stg-secret>;ApplicationIntent=ReadOnly;MultiSubnetFailover=True;Encrypt=True;TrustServerCertificate=False;Application Name=appdb-data-api
# CONN_ID_MSGDATA=Server=ag-staging-listener,1433;Database=AppDb_Data;User ID=svc_dataapi;Password=<stg-secret>;ApplicationIntent=ReadOnly;MultiSubnetFailover=True;Encrypt=True;TrustServerCertificate=False;Application Name=appdb-data-api

# === DEV (standalone config/dab-config.dev.json — single AppDb_dev on DEV-NODE1) ===
# All 6 tool procs live in AppDb_dev; SMS search uses core.MessageLog_SearchByFilter_v5 (unmasked; test data only).
CONN_DEV=Server=DEV-NODE1,1433;Database=AppDb_dev;User ID=svc_dataapi;Password=<dev-secret>;ApplicationIntent=ReadOnly;Encrypt=True;TrustServerCertificate=False;Application Name=appdb-data-api

# NOTE: ID and UK read-only routing currently points at :5022 (HADR endpoint), not :1433 —
# ApplicationIntent=ReadOnly will fail to route there until READ_ONLY_ROUTING_URL is fixed to :1433.
# See deploy/01-create-login-and-grants.sql header.

# --- Inbound identity (validated by DAB in PROD; base EntraID provider) ---
# From example SSO once Ed/IT registers this API as a consumer (see deploy/README.md).
# Not used when DAB_ENVIRONMENT=Local/Staging or the dev config (Simulator provider).
AUTH_JWT_AUDIENCE=<example-sso-audience-or-app-id-uri>
AUTH_JWT_ISSUER=https://<example-sso-issuer>/

# --- Observability (optional; DAB tolerates these being unset) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
